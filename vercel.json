{
    "builds": [
        {
            "src": "python-backend/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "python-backend/main.py"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}